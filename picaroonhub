            local Knob = Instance.new("Frame")
            Knob.Size = UDim2.fromOffset(18, 18)
            Knob.Position = cfg.Default and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
            Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Knob.Parent = Switch
            AddCorner(Knob, UDim.new(1, 0))

            local state = cfg.Default == true
            if cfg.Flag then Picaroon.Flags[cfg.Flag] = state end

            local function setState(newState, fireCallback)
                state = newState == true
                if state then
                    Tween(Switch, { BackgroundColor3 = Theme.Accent }, 0.2)
                    Tween(Knob, { Position = UDim2.new(1, -20, 0.5, -9) }, 0.2)
                    Tween(glow, { Thickness = 2 }, 0.2)
                else
                    Tween(Switch, { BackgroundColor3 = Theme.ToggleOff }, 0.2)
                    Tween(Knob, { Position = UDim2.new(0, 2, 0.5, -9) }, 0.2)
                    Tween(glow, { Thickness = 0 }, 0.2)
                end
                if cfg.Flag then Picaroon.Flags[cfg.Flag] = state end
                if fireCallback and cfg.Callback then
                    local ok, err = pcall(cfg.Callback, state)
                    if not ok then warn("[Picaroon] Toggle callback error: " .. tostring(err)) end
                end
            end

            onTheme(function(t)
                Tween(Switch, { BackgroundColor3 = state and t.Accent or t.ToggleOff }, 0.2)
                Tween(glow, { Color = t.AccentGlow }, 0.2)
            end)

            ToggleFrame.MouseButton1Click:Connect(function()
                setState(not state, true)
            end)
            ToggleFrame.MouseEnter:Connect(function()
                Tween(ToggleFrame, { BackgroundTransparency = 0, BackgroundColor3 = Theme.HoverColor }, 0.15)
            end)
            ToggleFrame.MouseLeave:Connect(function()
                Tween(ToggleFrame, { BackgroundTransparency = 0.3, BackgroundColor3 = Theme.Sidebar }, 0.15)
            end)

            return {
                Instance = ToggleFrame,
                Set = function(v, fire) setState(v, fire == true) end,
                Get = function() return state end,
            }
        end

        function Tab:CreateSlider(cfg)
