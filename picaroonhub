        Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabFrame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)
        end)

        table.insert(self.TabButtons, TabButton)
        table.insert(self.TabFrames, TabFrame)

        local function switchTab()
            if self.CurrentTab == TabFrame then return end
            self.CurrentTab = TabFrame
            for _, btn in ipairs(self.TabButtons) do
                Tween(btn, { BackgroundTransparency = 0.5, TextColor3 = Theme.SubText }, 0.2)
            end
            Tween(TabButton, { BackgroundTransparency = 0.1, TextColor3 = Theme.Text }, 0.2)
            Tween(Indicator, { Position = UDim2.new(0, 0, 0, TabButton.Position.Y.Offset) }, 0.25, Enum.EasingStyle.Quart)
            for _, frame in ipairs(self.TabFrames) do frame.Visible = false end
            TabFrame.Visible = true
        end

        TabButton.MouseButton1Click:Connect(switchTab)
        TabButton.MouseEnter:Connect(function()
            if self.CurrentTab ~= TabFrame then
                Tween(TabButton, { TextColor3 = Theme.Text, BackgroundTransparency = 0.35 }, 0.15)
            end
        end)
        TabButton.MouseLeave:Connect(function()
            if self.CurrentTab ~= TabFrame then
                Tween(TabButton, { TextColor3 = Theme.SubText, BackgroundTransparency = 0.5 }, 0.15)
            end
        end)

        if #self.TabButtons == 1 then switchTab() end
        return self:SetupTab(TabFrame)
    end

