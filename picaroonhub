            ValueLabel.Parent = SliderFrame

            local Track = Instance.new("Frame")
            Track.Size = UDim2.new(1, -24, 0, 6)
            Track.Position = UDim2.new(0, 12, 0, 32)
            Track.BackgroundColor3 = Theme.ToggleOff
            Track.BorderSizePixel = 0
            Track.Active = true
            Track.Parent = SliderFrame
            AddCorner(Track, UDim.new(1, 0))

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((value - Min) / (Max - Min), 0, 1, 0)
            Fill.BackgroundColor3 = Theme.Accent
            Fill.BorderSizePixel = 0
            Fill.Parent = Track
            AddCorner(Fill, UDim.new(1, 0))
            onTheme(function(t)
                Tween(Fill, { BackgroundColor3 = t.Accent }, 0.25)
            end)

            local Knob = Instance.new("Frame")
            Knob.Size = UDim2.fromOffset(14, 14)
            Knob.AnchorPoint = Vector2.new(0.5, 0.5)
            Knob.Position = UDim2.new((value - Min) / (Max - Min), 0, 0.5, 0)
            Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Knob.ZIndex = 2
            Knob.Parent = Track
            AddCorner(Knob, UDim.new(1, 0))

            local dragging = false

            local function setFromAlpha(alpha, fireCallback)
                alpha = math.clamp(alpha, 0, 1)
                local raw = Min + (Max - Min) * alpha
                local steps = Round(raw / Increment, 0)
                value = math.clamp(Round(steps * Increment, 4), Min, Max)
                local newAlpha = (value - Min) / (Max - Min)
                Fill.Size = UDim2.new(newAlpha, 0, 1, 0)
                Knob.Position = UDim2.new(newAlpha, 0, 0.5, 0)
                ValueLabel.Text = tostring(Round(value, 2))
                if cfg.Flag then Picaroon.Flags[cfg.Flag] = value end
                if fireCallback and cfg.Callback then
                    local ok, err = pcall(cfg.Callback, value)
                    if not ok then warn("[Picaroon] Slider callback error: " .. tostring(err)) end
                end
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
                    and input.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end
                dragging = true
                setFromAlpha((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, true)
            end)
            bag:Add(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end))
            bag:Add(UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement
                    and input.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end
                setFromAlpha((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, true)
            end))

            return {
                Instance = SliderFrame,
                Set = function(v, fire) setFromAlpha((v - Min) / (Max - Min), fire == true) end,
                Get = function() return value end,
            }
        end

        function Tab:CreateDropdown(cfg)
            cfg = cfg or {}
            local Options = cfg.Options or {}
            local selected = cfg.Default

            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, -10, 0, 38)
            DropFrame.BackgroundColor3 = Theme.Sidebar
            DropFrame.BackgroundTransparency = 0.3
            DropFrame.ClipsDescendants = true
            DropFrame.Parent = tabFrame
            AddCorner(DropFrame, UDim.new(0, 8))

            local Header = Instance.new("TextButton")
            Header.Size = UDim2.new(1, 0, 0, 38)
            Header.BackgroundTransparency = 1
            Header.Text = ""
            Header.AutoButtonColor = false
            Header.Parent = DropFrame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -40, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = (cfg.Name or "Dropdown") .. (selected and (": " .. tostring(selected)) or "")
            Label.TextColor3 = Theme.Text
            Label.Font = Theme.Font
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.TextTruncate = Enum.TextTruncate.AtEnd
            Label.Parent = Header

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.fromOffset(20, 20)
            Arrow.Position = UDim2.new(1, -30, 0, 9)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▾"
            Arrow.TextColor3 = Theme.SubText
            Arrow.Font = Theme.FontBold
            Arrow.TextSize = 14
            Arrow.Parent = Header

            local OptionHolder = Instance.new("Frame")
            OptionHolder.Size = UDim2.new(1, 0, 0, #Options * 30)
            OptionHolder.Position = UDim2.new(0, 0, 0, 38)
            OptionHolder.BackgroundTransparency = 1
            OptionHolder.Parent = DropFrame

            local open = false
            local function setSelected(opt, fireCallback)
                selected = opt
                Label.Text = (cfg.Name or "Dropdown") .. ": " .. tostring(opt)
                if cfg.Flag then Picaroon.Flags[cfg.Flag] = opt end
                if fireCallback and cfg.Callback then
                    local ok, err = pcall(cfg.Callback, opt)
                    if not ok then warn("[Picaroon] Dropdown callback error: " .. tostring(err)) end
                end
            end

            for i, opt in ipairs(Options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Size = UDim2.new(1, -16, 0, 26)
                OptBtn.Position = UDim2.new(0, 8, 0, (i - 1) * 30)
                OptBtn.BackgroundColor3 = Theme.HoverColor
                OptBtn.BackgroundTransparency = 0.2
                OptBtn.Text = tostring(opt)
                OptBtn.TextColor3 = Theme.Text
                OptBtn.Font = Theme.Font
                OptBtn.TextSize = 12
                OptBtn.AutoButtonColor = false
                OptBtn.Parent = OptionHolder
                AddCorner(OptBtn, UDim.new(0, 6))
                OptBtn.MouseEnter:Connect(function()
                    Tween(OptBtn, { BackgroundTransparency = 0 }, 0.12)
                end)
                OptBtn.MouseLeave:Connect(function()
                    Tween(OptBtn, { BackgroundTransparency = 0.2 }, 0.12)
                end)
                OptBtn.MouseButton1Click:Connect(function()
                    setSelected(opt, true)
                    open = false
                    Tween(DropFrame, { Size = UDim2.new(1, -10, 0, 38) }, 0.2)
                    Tween(Arrow, { Rotation = 0 }, 0.2)
                end)
            end

            Header.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    Tween(DropFrame, { Size = UDim2.new(1, -10, 0, 38 + #Options * 30) }, 0.25)
                    Tween(Arrow, { Rotation = 180 }, 0.2)
                else
                    Tween(DropFrame, { Size = UDim2.new(1, -10, 0, 38) }, 0.2)
                    Tween(Arrow, { Rotation = 0 }, 0.2)
                end
            end)

            if selected and cfg.Flag then Picaroon.Flags[cfg.Flag] = selected end

            return { Instance = DropFrame, Set = setSelected, Get = function() return selected end }
        end

        function Tab:CreateInput(cfg)
            cfg = cfg or {}
            local InputFrame = Instance.new("Frame")
            InputFrame.Size = UDim2.new(1, -10, 0, 38)
            InputFrame.BackgroundColor3 = Theme.Sidebar
            InputFrame.BackgroundTransparency = 0.3
            InputFrame.Parent = tabFrame
            AddCorner(InputFrame, UDim.new(0, 8))

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.4, -12, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = cfg.Name or "Input"
            Label.TextColor3 = Theme.Text
            Label.Font = Theme.Font
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.TextTruncate = Enum.TextTruncate.AtEnd
            Label.Parent = InputFrame

            local Box = Instance.new("TextBox")
            Box.Size = UDim2.new(0.6, -20, 0, 26)
            Box.Position = UDim2.new(0.4, 0, 0.5, -13)
            Box.BackgroundColor3 = Theme.ToggleOff
            Box.Text = cfg.Default or ""
            Box.PlaceholderText = cfg.PlaceHolder or ""
            Box.TextColor3 = Theme.Text
            Box.PlaceholderColor3 = Theme.SubText
            Box.Font = Theme.Font
            Box.TextSize = 12
            Box.ClearTextOnFocus = false
            Box.Parent = InputFrame
            AddCorner(Box, UDim.new(0, 6))
            local pad = Instance.new("UIPadding", Box)
            pad.PaddingLeft = UDim.new(0, 8)
            pad.PaddingRight = UDim.new(0, 8)

            Box.FocusLost:Connect(function(enterPressed)
                if cfg.Flag then Picaroon.Flags[cfg.Flag] = Box.Text end
                if cfg.Callback and (enterPressed or not cfg.EnterOnly) then
                    local ok, err = pcall(cfg.Callback, Box.Text, enterPressed)
                    if not ok then warn("[Picaroon] Input callback error: " .. tostring(err)) end
                end
            end)

            return {
                Instance = InputFrame,
                Set = function(text) Box.Text = text end,
                Get = function() return Box.Text end,
            }
        end

        function Tab:CreateKeybind(cfg)
            cfg = cfg or {}
            local currentKey = cfg.Default or Enum.KeyCode.Unknown
            local listening = false

            local BindFrame = Instance.new("Frame")
            BindFrame.Size = UDim2.new(1, -10, 0, 38)
            BindFrame.BackgroundColor3 = Theme.Sidebar
            BindFrame.BackgroundTransparency = 0.3
            BindFrame.Parent = tabFrame
            AddCorner(BindFrame, UDim.new(0, 8))

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -90, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = cfg.Name or "Keybind"
            Label.TextColor3 = Theme.Text
            Label.Font = Theme.Font
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.TextTruncate = Enum.TextTruncate.AtEnd
            Label.Parent = BindFrame

            local KeyBtn = Instance.new("TextButton")
            KeyBtn.Size = UDim2.fromOffset(70, 26)
            KeyBtn.Position = UDim2.new(1, -80, 0.5, -13)
            KeyBtn.BackgroundColor3 = Theme.ToggleOff
            KeyBtn.Text = currentKey.Name
            KeyBtn.TextColor3 = Theme.Text
            KeyBtn.Font = Theme.FontBold
            KeyBtn.TextSize = 12
            KeyBtn.AutoButtonColor = false
            KeyBtn.Parent = BindFrame
            AddCorner(KeyBtn, UDim.new(0, 6))

            KeyBtn.MouseButton1Click:Connect(function()
                listening = true
                KeyBtn.Text = "..."
                Tween(KeyBtn, { BackgroundColor3 = Theme.Accent }, 0.15)
            end)

            bag:Add(UserInputService.InputBegan:Connect(function(input, gpe)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    KeyBtn.Text = currentKey.Name
                    listening = false
                    Tween(KeyBtn, { BackgroundColor3 = Theme.ToggleOff }, 0.15)
                    if cfg.Flag then Picaroon.Flags[cfg.Flag] = currentKey end
                    return
                end
                if gpe or listening then return end
                if input.KeyCode == currentKey and cfg.Callback then
                    local ok, err = pcall(cfg.Callback)
                    if not ok then warn("[Picaroon] Keybind callback error: " .. tostring(err)) end
                end
            end))

            if cfg.Flag then Picaroon.Flags[cfg.Flag] = currentKey end
            return { Instance = BindFrame, Get = function() return currentKey end }
        end

        function Tab:CreateColorPicker(cfg)
            cfg = cfg or {}
            local color = cfg.Default or Color3.fromRGB(138, 43, 226)

            local PickerFrame = Instance.new("Frame")
            PickerFrame.Size = UDim2.new(1, -10, 0, 38)
            PickerFrame.BackgroundColor3 = Theme.Sidebar
            PickerFrame.BackgroundTransparency = 0.3
            PickerFrame.ClipsDescendants = true
            PickerFrame.Parent = tabFrame
            AddCorner(PickerFrame, UDim.new(0, 8))

            local Header = Instance.new("TextButton")
            Header.Size = UDim2.new(1, 0, 0, 38)
            Header.BackgroundTransparency = 1
            Header.Text = ""
            Header.AutoButtonColor = false
            Header.Parent = PickerFrame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -56, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = cfg.Name or "Color"
            Label.TextColor3 = Theme.Text
            Label.Font = Theme.Font
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.TextTruncate = Enum.TextTruncate.AtEnd
            Label.Parent = Header

            local Preview = Instance.new("Frame")
            Preview.Size = UDim2.fromOffset(26, 26)
            Preview.Position = UDim2.new(1, -36, 0.5, -13)
            Preview.BackgroundColor3 = color
            Preview.Parent = Header
            AddCorner(Preview, UDim.new(0, 6))
            AddStroke(Preview, Theme.Text, 1, 0.7)

            local Body = Instance.new("Frame")
            Body.Size = UDim2.new(1, -24, 0, 110)
            Body.Position = UDim2.new(0, 12, 0, 44)
            Body.BackgroundTransparency = 1
            Body.Parent = PickerFrame

            local function channelRow(index, label, initial)
                local Row = Instance.new("Frame")
                Row.Size = UDim2.new(1, 0, 0, 30)
                Row.Position = UDim2.new(0, 0, 0, (index - 1) * 34)
                Row.BackgroundTransparency = 1
                Row.Parent = Body

                local RowLabel = Instance.new("TextLabel")
                RowLabel.Size = UDim2.fromOffset(16, 26)
                RowLabel.BackgroundTransparency = 1
                RowLabel.Text = label
                RowLabel.TextColor3 = Theme.SubText
                RowLabel.Font = Theme.FontBold
                RowLabel.TextSize = 12
                RowLabel.Parent = Row

                local Track = Instance.new("Frame")
                Track.Size = UDim2.new(1, -56, 0, 6)
                Track.Position = UDim2.new(0, 20, 0.5, -3)
                Track.BackgroundColor3 = Theme.ToggleOff
                Track.BorderSizePixel = 0
                Track.Active = true
                Track.Parent = Row
                AddCorner(Track, UDim.new(1, 0))

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new(initial, 0, 1, 0)
                Fill.BackgroundColor3 = Theme.Accent
                Fill.BorderSizePixel = 0
                Fill.Parent = Track
                AddCorner(Fill, UDim.new(1, 0))

                local ValLabel = Instance.new("TextLabel")
                ValLabel.Size = UDim2.fromOffset(30, 26)
                ValLabel.Position = UDim2.new(1, -30, 0, 0)
                ValLabel.BackgroundTransparency = 1
                ValLabel.Text = tostring(math.floor(initial * 255))
                ValLabel.TextColor3 = Theme.SubText
                ValLabel.Font = Theme.Font
                ValLabel.TextSize = 11
                ValLabel.Parent = Row

                return Track, Fill, ValLabel
            end

            local r, g, b = color.R, color.G, color.B
            local rTrack, rFill, rVal = channelRow(1, "R", r)
            local gTrack, gFill, gVal = channelRow(2, "G", g)
            local bTrack, bFill, bVal = channelRow(3, "B", b)

            onTheme(function(t)
                Tween(rFill, { BackgroundColor3 = t.Accent }, 0.25)
                Tween(gFill, { BackgroundColor3 = t.Accent }, 0.25)
                Tween(bFill, { BackgroundColor3 = t.Accent }, 0.25)
            end)

            local function updateColor(fireCallback)
                color = Color3.new(r, g, b)
                Preview.BackgroundColor3 = color
                if cfg.Flag then Picaroon.Flags[cfg.Flag] = color end
                if fireCallback and cfg.Callback then
                    local ok, err = pcall(cfg.Callback, color)
                    if not ok then warn("[Picaroon] ColorPicker callback error: " .. tostring(err)) end
                end
            end

            local function bindChannel(track, fill, valLbl, setter)
                local dragging = false
                local function apply(alpha)
                    alpha = math.clamp(alpha, 0, 1)
                    fill.Size = UDim2.new(alpha, 0, 1, 0)
                    valLbl.Text = tostring(math.floor(alpha * 255))
                    setter(alpha)
                    updateColor(true)
                end
                track.InputBegan:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType ~= Enum.UserInputType.Touch then
                        return
                    end
                    dragging = true
                    apply((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
                end)
                bag:Add(UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end))
                bag:Add(UserInputService.InputChanged:Connect(function(input)
                    if not dragging then return end
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement
                        and input.UserInputType ~= Enum.UserInputType.Touch then
                        return
                    end
                    apply((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
                end))
            end

            bindChannel(rTrack, rFill, rVal, function(a) r = a end)
            bindChannel(gTrack, gFill, gVal, function(a) g = a end)
            bindChannel(bTrack, bFill, bVal, function(a) b = a end)

            local open = false
            Header.MouseButton1Click:Connect(function()
                open = not open
                Tween(PickerFrame, { Size = UDim2.new(1, -10, 0, open and 160 or 38) }, 0.25)
            end)

            if cfg.Flag then Picaroon.Flags[cfg.Flag] = color end

            return {
                Instance = PickerFrame,
                Get = function() return color end,
                Set = function(c, fire)
                    r, g, b = c.R, c.G, c.B
                    rFill.Size = UDim2.new(r, 0, 1, 0)
                    gFill.Size = UDim2.new(g, 0, 1, 0)
                    bFill.Size = UDim2.new(b, 0, 1, 0)
                    rVal.Text = tostring(math.floor(r * 255))
                    gVal.Text = tostring(math.floor(g * 255))
                    bVal.Text = tostring(math.floor(b * 255))
                    updateColor(fire == true)
                end,
            }
        end

        return Tab
    end

    -- ---------------- Boot ----------------
    if ShowSplash then
        local splash = buildSplash()
        task.spawn(function()
            playSplash(splash, revealCanvas)
        end)
    else
        revealCanvas()
    end

    return Window
end

return Picaroon
