            Switch.Size = UDim2.fromOffset(40, 22)
            Switch.Position = UDim2.new(1, -50, 0.5, -11)
            Switch.BackgroundColor3 = cfg.Default and Theme.Accent or Theme.ToggleOff
            Switch.Parent = ToggleFrame
