    local function playSplash(splash, done)
        local texts = { "Initializing core...", "Loading modules...", "Securing link...", "Ready." }
        Tween(splash.Frame, { GroupTransparency = 0, Size = UDim2.fromOffset(320, 200) }, 0.35, Enum.EasingStyle.Back)
        task.wait(0.35)
        for i, text in ipairs(texts) do
            if not splash.Frame.Parent or Window._destroyed then return end
            splash.Status.Text = text
            Tween(splash.Fill, { Size = UDim2.new(i / #texts, 0, 1, 0) }, 0.22, Enum.EasingStyle.Quart)
            task.wait(0.24)
        end
        task.wait(0.15)
        if not splash.Frame.Parent then return end
        Tween(splash.Frame, { GroupTransparency = 1, Size = UDim2.fromOffset(400, 300) }, 0.3)
        task.wait(0.3)
        splash.Frame:Destroy()
        done()
    end

