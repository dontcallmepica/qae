    -- ---------------- Watermark ----------------
    function Window:CreateWatermark(wmConfig)
        wmConfig = wmConfig or {}
        local Position = wmConfig.Position or UDim2.new(1, -220, 1, -70)

        local WM = Instance.new("Frame")
        WM.Name = "Watermark"
        WM.Size = UDim2.new(0, 210, 0, 0)
        WM.AutomaticSize = Enum.AutomaticSize.Y
        WM.Position = Position
        WM.BackgroundColor3 = Theme.Background
        WM.BackgroundTransparency = 0.08
        WM.BorderSizePixel = 0
        WM.Active = true
        WM.Parent = ScreenGui
        AddCorner(WM, UDim.new(0, 8))
        local wmStroke = AddStroke(WM, Theme.Accent, 1, 0.4)
        onTheme(function(t)
            Tween(wmStroke, { Color = t.Accent }, 0.25)
        end)

        local Layout = Instance.new("UIListLayout", WM)
        Layout.Padding = UDim.new(0, 4)
        Layout.SortOrder = Enum.SortOrder.LayoutOrder

        local Padding = Instance.new("UIPadding", WM)
        Padding.PaddingTop = UDim.new(0, 8)
        Padding.PaddingBottom = UDim.new(0, 8)
        Padding.PaddingLeft = UDim.new(0, 10)
        Padding.PaddingRight = UDim.new(0, 10)

        local wmDragging = false
        local wmStart = Vector2.zero
        local wmOrigin = UDim2.new()

        bag:Add(WM.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            wmDragging = true
            wmStart = input.Position
            wmOrigin = WM.Position
        end))
        bag:Add(UserInputService.InputChanged:Connect(function(input)
            if not wmDragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local delta = input.Position - wmStart
            WM.Position = UDim2.new(wmOrigin.X.Scale, wmOrigin.X.Offset + delta.X,
                wmOrigin.Y.Scale, wmOrigin.Y.Offset + delta.Y)
        end))
        bag:Add(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                wmDragging = false
            end
        end))

        local Watermark = { Lines = {}, Instance = WM }

        function Watermark:SetLine(key, text, color)
            local line = self.Lines[key]
            if not line then
                line = Instance.new("TextLabel")
                line.Size = UDim2.new(1, 0, 0, 16)
                line.BackgroundTransparency = 1
                line.Font = Theme.Font
                line.TextSize = 12
                line.TextXAlignment = Enum.TextXAlignment.Left
                line.Parent = WM
                self.Lines[key] = line
            end
            line.Text = text
            line.TextColor3 = color or Theme.Text
        end

        function Watermark:RemoveLine(key)
            local line = self.Lines[key]
            if line then
                line:Destroy()
                self.Lines[key] = nil
            end
        end

        function Watermark:Clear()
            for key in pairs(self.Lines) do self:RemoveLine(key) end
        end

        return Watermark
    end

