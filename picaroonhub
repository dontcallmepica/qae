    local function getExpandedSize()
        local abs = Canvas.AbsoluteSize
        if abs.X > 1 and abs.Y > 1 then
            return UDim2.fromOffset(abs.X, abs.Y)
        end
        return expandedSize
    end

    local function setMinimized(value)
        if minimized == value then return end
        minimized = value
        if minimized then
            expandedSize = getExpandedSize()
            Tween(Canvas, { Size = UDim2.fromOffset(expandedSize.X.Offset, 45) }, 0.3)
        else
            Tween(Canvas, { Size = expandedSize }, 0.3)
        end
        if resizeHandle then resizeHandle.Visible = not minimized end
    end

