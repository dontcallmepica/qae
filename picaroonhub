    AddCorner(CloseBtn, UDim.new(0, 6))

    -- ---------------- Drag (clamped) ----------------
    local dragging = false
    local dragStart = Vector2.zero
    local dragOrigin = Vector2.zero

    local function clampCanvasPosition()
        local vp = GetViewport()
        local abs = Canvas.AbsolutePosition
        local size = Canvas.AbsoluteSize
        if size.X < 1 or size.Y < 1 then return end
        local maxX = math.max(Margin, vp.X - size.X - Margin)
        local maxY = math.max(Margin, vp.Y - size.Y - Margin)
        local x = math.clamp(abs.X, Margin, maxX)
        local y = math.clamp(abs.Y, Margin, maxY)
        if x ~= abs.X or y ~= abs.Y then
            Canvas.Position = UDim2.new(0.5, x + size.X / 2 - vp.X / 2, 0.5, y + size.Y / 2 - vp.Y / 2)
        end
    end

    bag:Add(DragArea.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        dragStart = input.Position
        dragOrigin = Canvas.AbsolutePosition
    end))

    bag:Add(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local vp = GetViewport()
        local size = Canvas.AbsoluteSize
        local delta = input.Position - dragStart
        local maxX = math.max(Margin, vp.X - size.X - Margin)
        local maxY = math.max(Margin, vp.Y - size.Y - Margin)
        local x = math.clamp(dragOrigin.X + delta.X, Margin, maxX)
        local y = math.clamp(dragOrigin.Y + delta.Y, Margin, maxY)
        Canvas.Position = UDim2.new(0.5, x + size.X / 2 - vp.X / 2, 0.5, y + size.Y / 2 - vp.Y / 2)
    end))

    bag:Add(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    local function onViewportChanged()
        clampCanvasPosition()
    end
    if workspace.CurrentCamera then
        bag:Add(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(onViewportChanged))
    end
    bag:Add(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local cam = workspace.CurrentCamera
        if cam then
            bag:Add(cam:GetPropertyChangedSignal("ViewportSize"):Connect(onViewportChanged))
        end
    end))

    -- ---------------- Content ----------------
    local ContentArea = Instance.new("Frame")
    ContentArea.Size = UDim2.new(1, 0, 1, -45)
    ContentArea.Position = UDim2.new(0, 0, 0, 45)
