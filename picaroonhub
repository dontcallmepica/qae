-- ============================================================
-- UTILS
-- ============================================================
local function Tween(Object, Properties, Time, Style, Dir)
    if not Object or not Object.Parent then return nil end
    local Info = TweenInfo.new(Time or 0.2, Style or Enum.EasingStyle.Quart, Dir or Enum.EasingDirection.Out)
    local ok, T = pcall(TweenService.Create, TweenService, Object, Info, Properties)
    if not ok or not T then return nil end
    T:Play()
    return T
end

local function Round(value, decimals)
    local mult = 10 ^ (decimals or 0)
    local scaled = value * mult
    if scaled >= 0 then
        return math.floor(scaled + 0.5) / mult
    end
    return math.ceil(scaled - 0.5) / mult
end

local function AddCorner(obj, radius)
    local c = Instance.new("UICorner")
    if typeof(radius) == "UDim" then
        c.CornerRadius = radius
    else
        c.CornerRadius = UDim.new(0, radius or 8)
    end
    c.Parent = obj
    return c
end

local function AddStroke(obj, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Accent
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.5
    s.Parent = obj
    return s
end

local function AddGradient(obj, rotation, colorSeq, transSeq)
    local g = Instance.new("UIGradient")
    g.Rotation = rotation or 90
    g.Color = colorSeq or ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255))
    if transSeq then g.Transparency = transSeq end
    g.Parent = obj
    return g
end

local function GetViewport()
    local cam = workspace.CurrentCamera
    if cam then return cam.ViewportSize end
    return Vector2.new(1920, 1080)
end

-- Bounded connection collection so a window can be torn down cleanly.
local ConnectionBag = {}
ConnectionBag.__index = ConnectionBag

function ConnectionBag.new()
    return setmetatable({ items = {} }, ConnectionBag)
end

function ConnectionBag:Add(connection)
    if connection then
        table.insert(self.items, connection)
    end
    return connection
end

function ConnectionBag:Clear()
    for _, connection in ipairs(self.items) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(self.items)
end

-- ============================================================
-- GEASS SYMBOL
-- ============================================================
local function CreateGeassSymbol(parent, size)
    local container = Instance.new("Frame")
    container.Name = "GeassSymbol"
    container.Size = UDim2.fromOffset(size, size)
    container.BackgroundTransparency = 1
    container.Parent = parent

    local eye = Instance.new("Frame")
    eye.Size = UDim2.fromOffset(size * 0.5, size * 0.5)
    eye.Position = UDim2.new(0.5, -size * 0.25, 0.5, -size * 0.25)
    eye.Rotation = 45
    eye.BackgroundColor3 = Theme.GeassRed
    eye.BorderSizePixel = 0
    eye.Parent = container
    AddCorner(eye, UDim.new(0.3, 0))

    local eyeStroke = AddStroke(eye, Theme.GeassRed, 2, 0.3)

    local innerEye = Instance.new("Frame")
    innerEye.Size = UDim2.fromOffset(size * 0.25, size * 0.25)
    innerEye.Position = UDim2.new(0.5, -size * 0.125, 0.5, -size * 0.125)
    innerEye.Rotation = 45
    innerEye.BackgroundColor3 = Color3.fromRGB(20, 5, 15)
    innerEye.BorderSizePixel = 0
    innerEye.Parent = container
    AddCorner(innerEye, UDim.new(0.3, 0))

    local leftWing = Instance.new("Frame")
    leftWing.Size = UDim2.fromOffset(size * 0.45, size * 0.06)
    leftWing.Position = UDim2.new(0.5, -size * 0.5, 0.5, -size * 0.2)
    leftWing.Rotation = -30
    leftWing.BackgroundColor3 = Theme.GeassRed
    leftWing.BorderSizePixel = 0
    leftWing.Parent = container
    AddCorner(leftWing, UDim.new(1, 0))

    local rightWing = Instance.new("Frame")
    rightWing.Size = UDim2.fromOffset(size * 0.45, size * 0.06)
    rightWing.Position = UDim2.new(0.5, size * 0.05, 0.5, -size * 0.2)
    rightWing.Rotation = 30
    rightWing.BackgroundColor3 = Theme.GeassRed
    rightWing.BorderSizePixel = 0
    rightWing.Parent = container
    AddCorner(rightWing, UDim.new(1, 0))

    local tail = Instance.new("Frame")
    tail.Size = UDim2.fromOffset(size * 0.06, size * 0.3)
    tail.Position = UDim2.new(0.5, -size * 0.03, 0.65, 0)
    tail.BackgroundColor3 = Theme.GeassRed
    tail.BorderSizePixel = 0
    tail.Parent = container
    AddCorner(tail, UDim.new(1, 0))

    task.spawn(function()
        while container.Parent do
            Tween(eye, { BackgroundColor3 = Theme.AccentGlow }, 0.6)
            Tween(eyeStroke, { Color = Theme.AccentGlow, Transparency = 0 }, 0.6)
            task.wait(0.6)
            if not container.Parent then break end
            Tween(eye, { BackgroundColor3 = Theme.GeassRed }, 0.6)
            Tween(eyeStroke, { Color = Theme.GeassRed, Transparency = 0.3 }, 0.6)
            task.wait(0.6)
        end
    end)
    return container
end

