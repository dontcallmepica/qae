    AddCorner(Indicator, UDim.new(1, 0))
    onTheme(function(t)
        Tween(Indicator, { BackgroundColor3 = t.Accent }, 0.25)
    end)

    -- ---------------- Resize ----------------
    if Resizable then
        resizeHandle = Instance.new("Frame")
        resizeHandle.Name = "ResizeHandle"
        resizeHandle.Size = UDim2.fromOffset(14, 14)
        resizeHandle.Position = UDim2.new(1, -14, 1, -14)
        resizeHandle.BackgroundColor3 = Theme.Accent
        resizeHandle.BackgroundTransparency = 0.5
        resizeHandle.BorderSizePixel = 0
        resizeHandle.Parent = MainFrame
        AddCorner(resizeHandle, UDim.new(0, 4))

        local resizing = false
        local resizeStart = Vector2.zero
        local startSize = Vector2.zero

        bag:Add(resizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            resizing = true
            resizeStart = input.Position
            startSize = Canvas.AbsoluteSize
        end))

        bag:Add(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end))

        bag:Add(UserInputService.InputChanged:Connect(function(input)
            if not resizing then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local vp = GetViewport()
            local delta = input.Position - resizeStart
            local maxW = math.max(420, vp.X - Margin * 2)
            local maxH = math.max(320, vp.Y - Margin * 2)
            local newX = math.clamp(startSize.X + delta.X, 420, maxW)
            local newY = math.clamp(startSize.Y + delta.Y, 320, maxH)
            Canvas.Size = UDim2.fromOffset(newX, newY)
            expandedSize = Canvas.Size
            clampCanvasPosition()
        end))
    end

    -- ---------------- Toggle key ----------------
    bag:Add(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == ToggleKey then
            ScreenGui.Enabled = not ScreenGui.Enabled
