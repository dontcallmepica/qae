        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0),
        Theme = { BackgroundColor3 = "Outline" }, Parent = sidebar,
    })
    win._tabList = New("ScrollingFrame", {
        Size = UDim2.new(1, -1, 1, -52), ScrollBarThickness = 0, Parent = sidebar,
    }, {
        New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
        New("UIPadding", {
            PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
        }),
    })

    -- sidebar footer: player name and avatar (avatar loads in the background)
    local footer = New("Frame", {
        Size = UDim2.new(1, -1, 0, 52), Position = UDim2.new(0, 0, 1, -52), BackgroundTransparency = 1, Parent = sidebar,
    })
    New("Frame", {
        Size = UDim2.new(1, -16, 0, 1), Position = UDim2.fromOffset(8, 0),
        Theme = { BackgroundColor3 = "Outline" }, Parent = footer,
    })
    local avatar = New("ImageLabel", {
        Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
        Theme = { BackgroundColor3 = "Surface" }, BackgroundTransparency = 0, Parent = footer,
    }, { Round() })
    New("TextLabel", {
        Text = LocalPlayer and LocalPlayer.DisplayName or "Player", Size = UDim2.new(1, -56, 0, 18),
        Position = UDim2.fromOffset(50, 17), TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, Parent = footer,
    })
    task.spawn(function()
        local ok, img = pcall(function()
            return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
        end)
        if ok and avatar.Parent then avatar.Image = img end
    end)

    win._pages = New("Frame", {
        Name = "Pages", Size = UDim2.new(1, -160, 1, 0), Position = UDim2.fromOffset(160, 0),
        BackgroundTransparency = 1, ClipsDescendants = true, Parent = body,
    })

    Library:_OnTheme(function() win:_RefreshTabs() end, j)

    -- resize handle -------------------------------------------------
    if cfg.Resizable ~= false then
        local grip = New("TextButton", {
            Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -18, 1, -18), ZIndex = 20, Parent = main,
        })
        New("Frame", {
            Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(6, 6), BackgroundTransparency = 0.5,
            Theme = { BackgroundColor3 = "Accent" }, Parent = grip,
        }, { Corner(2) })
        local resizing, startMouse, startSize, startPos = false, nil, nil, nil
        grip.InputBegan:Connect(function(input)
            if IsPress(input) then
                resizing = true
                startMouse = Vector2.new(input.Position.X, input.Position.Y)
                startSize = main.AbsoluteSize
                startPos = main.Position
            end
        end)
        On(j, UserInputService.InputChanged, function(input)
            if resizing and IsMove(input) then
                local d = Vector2.new(input.Position.X, input.Position.Y) - startMouse
                local w = math.clamp(startSize.X + d.X, minSize.X, 1100)
                local h = math.clamp(startSize.Y + d.Y, minSize.Y, 760)
                main.Size = UDim2.fromOffset(w, h)
                -- keep the top-left corner fixed while the centred window grows
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + (w - startSize.X) / 2,
                    startPos.Y.Scale, startPos.Y.Offset + (h - startSize.Y) / 2
                )
            end
        end)
        On(j, UserInputService.InputEnded, function(input)
            if IsPress(input) then resizing = false end
        end)
    end

    -- notifications holder ------------------------------------------
    win._notifyHolder = New("Frame", {
        Name = "Notifications", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.new(0, 280, 1, -32), BackgroundTransparency = 1, Parent = gui,
    }, {
        New("UIListLayout", {
            Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
        }),
    })

    -- menu toggle key -----------------------------------------------
    On(j, UserInputService.InputBegan, function(input, processed)
        if processed or Library._listening then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == win.ToggleKey then
            win:Toggle()
        end
    end)

    -- mobile open button --------------------------------------------
    local wantMobile = cfg.MobileButton
    if wantMobile == nil then
        wantMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    end
    if wantMobile then
        win._mobileBtn = New("TextButton", {
            Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0, 12, 0.5, -23),
            BackgroundTransparency = 0, Visible = false,
            Theme = { BackgroundColor3 = "Surface" }, Parent = gui,
        }, { Round(), New("UIStroke", { Thickness = 1.5, Theme = { Color = "Geass" } }) })
        local mLogo = MakeLogo(win._mobileBtn, 28, logoImage)
        mLogo.AnchorPoint = Vector2.new(0.5, 0.5)
        mLogo.Position = UDim2.fromScale(0.5, 0.5)
        win._mobileBtn.MouseButton1Click:Connect(function() win:SetVisible(true) end)
    end

    table.insert(Library.Windows, win)

    -- splash (runs in the background; the window API is usable immediately)
    local function Ready()
        if win.Destroyed then return end
        win._ready = true
        win:SetVisible(true)
        Fire(cfg.OnReady, win)
    end

    if cfg.Splash == false then
        Ready()
    else
        task.spawn(function()
            local steps = cfg.LoadingSteps or { "Initializing...", "Loading modules...", "Building interface...", "Ready" }
            local total = cfg.SplashTime or 1.6
            local per = total / #steps
            local splash = New("CanvasGroup", {
                Size = UDim2.fromOffset(300, 170), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                GroupTransparency = 1, Theme = { BackgroundColor3 = "Background" }, Parent = gui,
            }, {
                Corner(12),
                New("UIStroke", { Thickness = 1.5, Theme = { Color = "Outline" } }),
            })
            local sLogo = MakeLogo(splash, 64, logoImage)
            sLogo.AnchorPoint = Vector2.new(0.5, 0)
            sLogo.Position = UDim2.new(0.5, 0, 0, 18)
            New("TextLabel", {
                Text = string.upper(tostring(cfg.Title or "Picaroon Hub")), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 88),
                TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, TextSize = 16, Parent = splash,
            })
            local status = New("TextLabel", {
                Text = steps[1], Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 110),
                TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, Font = Enum.Font.Gotham,
                Theme = { TextColor3 = "SubText" }, Parent = splash,
            })
            local barBg = New("Frame", {
                Size = UDim2.new(1, -60, 0, 4), Position = UDim2.fromOffset(30, 140),
                Theme = { BackgroundColor3 = "Track" }, Parent = splash,
            }, { Round() })
            local barFill = New("Frame", {
                Size = UDim2.fromScale(0, 1), Theme = { BackgroundColor3 = "Accent" }, Parent = barBg,
            }, { Round() })

            Tween(splash, { GroupTransparency = 0 }, 0.3)
            task.wait(0.3)
            for i, text in ipairs(steps) do
                if win.Destroyed then return end
                status.Text = text
                Tween(barFill, { Size = UDim2.fromScale(i / #steps, 1) }, per * 0.9)
                task.wait(per)
            end
            Tween(splash, { GroupTransparency = 1 }, 0.3)
            task.wait(0.3)
            splash:Destroy()
            Ready()
        end)
    end

    return win
end

----------------------------------------------------------------------
-- Unload
----------------------------------------------------------------------
function Library:Unload()
    for i = #self.Windows, 1, -1 do
        self.Windows[i]:Destroy()
    end
    self.Janitor:Cleanup()
    self._themeCallbacks = {}
    self.Flags = {}
    self.Elements = {}
    if genv.__PICAROON == self then genv.__PICAROON = nil end
end

genv.__PICAROON = Library
return Library
