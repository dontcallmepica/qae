-- --------------------------------------------------------------- Slider
function Container:AddSlider(cfg)
    cfg = cfg or {}
    local j = self:_J()
    local page = self.Page
    local min, max = cfg.Min or 0, cfg.Max or 100
    local inc = cfg.Increment or 1
    if inc <= 0 then inc = 1 end
    local suffix = cfg.Suffix or ""
    local dec = DecimalsOf(inc)

    local function Snap(v)
        v = math.clamp(v, min, max)
        v = math.floor((v - min) / inc + 0.5) * inc + min
        v = math.clamp(v, min, max)
        local m = 10 ^ dec
        return math.floor(v * m + 0.5) / m
    end
    local function Format(v) return string.format("%." .. dec .. "f", v) .. suffix end

    local value = Snap(cfg.Default or min)
    local el = { Type = "Slider" }
    local row = self:_Row(52)

    New("TextLabel", {
        Text = tostring(cfg.Name or "Slider"), Size = UDim2.new(1, -110, 0, 18),
        Position = UDim2.fromOffset(12, 8), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
    })
    local box = New("TextBox", {
        Size = UDim2.fromOffset(86, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8),
        TextXAlignment = Enum.TextXAlignment.Right, Text = "", Theme = { TextColor3 = "SubText" }, Parent = row,
    })
    local track = New("Frame", {
        Size = UDim2.new(1, -24, 0, 6), Position = UDim2.fromOffset(12, 36),
        Theme = { BackgroundColor3 = "Track" }, Parent = row,
    }, { Round() })
    local fill = New("Frame", {
        Size = UDim2.fromScale(0, 1), Theme = { BackgroundColor3 = "Accent" }, Parent = track,
    }, { Round() })
    local knob = New("Frame", {
        Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1), Parent = track,
    }, { Round() })
    local hit = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 26), ZIndex = 5, Parent = row,
    })

    local function Alpha()
        if max == min then return 0 end
        return (value - min) / (max - min)
    end
    local function Render()
        local a = Alpha()
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        if not box:IsFocused() then box.Text = Format(value) end
    end
    Render()

    local function Commit(silent)
        if el.Flag then Library.Flags[el.Flag] = value end
        if not silent then Fire(cfg.Callback, value) end
    end

    local dragging = false
    local function FromInput(input)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / w, 0, 1)
        local v = Snap(min + (max - min) * a)
        if v ~= value then
            value = v
            Render()
            Commit(false)
        end
    end
    hit.InputBegan:Connect(function(input)
        if IsPress(input) then
            dragging = true
            page.ScrollingEnabled = false
            FromInput(input)
        end
    end)
    On(j, UserInputService.InputChanged, function(input)
        if dragging and IsMove(input) then FromInput(input) end
    end)
    On(j, UserInputService.InputEnded, function(input)
        if dragging and IsPress(input) then
            dragging = false
            page.ScrollingEnabled = true
        end
    end)

    box.Focused:Connect(function() box.Text = tostring(value) end)
    box.FocusLost:Connect(function()
        local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
        if n then el:Set(n) else Render() end
    end)

    function el:Get() return value end
    function el:Set(v, silent)
        value = Snap(tonumber(v) or value)
        Render()
        Commit(silent)
    end
    function el:_Export() return value end
    function el:_Import(v) self:Set(v) end
    return self:_Finish(el, row, cfg, j)
end

-- ------------------------------------------------------------- Dropdown
function Container:AddDropdown(cfg)
    cfg = cfg or {}
    local j = self:_J()
    local multi = cfg.Multi == true
    local options = {}
    for _, o in ipairs(cfg.Options or {}) do table.insert(options, tostring(o)) end
    local selected = {}
    local open = false
    local el = { Type = "Dropdown" }

    local row = self:_Row(36)
    New("TextLabel", {
        Text = tostring(cfg.Name or "Dropdown"), Size = UDim2.new(0.5, -12, 0, 18),
        Position = UDim2.fromOffset(12, 9), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
    })
    local valueLabel = New("TextLabel", {
        Size = UDim2.new(0.5, -40, 0, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 9),
        TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 12,
        Theme = { TextColor3 = "SubText" }, Parent = row,
    })
    local arrow = New("TextLabel", {
        Text = ">", Size = UDim2.fromOffset(16, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 9),
        TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold,
        Theme = { TextColor3 = "SubText" }, Parent = row,
    })
    local list = New("ScrollingFrame", {
        Position = UDim2.fromOffset(6, 40), Size = UDim2.new(1, -12, 0, 0), ScrollBarThickness = 2, Parent = row,
    }, { New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) })
    local hit = MakeHit(row, 36)
    AttachHover(hit, row)

    local function GetValue()
        if multi then
            local out = {}
            for _, o in ipairs(options) do
                if selected[o] then table.insert(out, o) end
            end
            return out
        end
        for _, o in ipairs(options) do
            if selected[o] then return o end
        end
        return nil
    end

    local function RenderValue()
        local v = GetValue()
        if multi then
            valueLabel.Text = (#v > 0) and table.concat(v, ", ") or "None"
        else
            valueLabel.Text = v or "None"
        end
    end

    local buttons = {}
    local function RenderOptions()
        for opt, b in pairs(buttons) do
            local on = selected[opt] == true
            Tween(b.btn, { BackgroundTransparency = on and 0 or 1 }, 0.1)
            b.lbl.TextColor3 = on and Library.Theme.Accent or Library.Theme.Text
        end
    end

    local function TargetHeight()
        return open and (36 + 4 + math.min(#options * 28, 150) + 6) or 36
    end

    local function Commit(silent)
        if el.Flag then Library.Flags[el.Flag] = GetValue() end
        if not silent then Fire(cfg.Callback, GetValue()) end
    end

    local function SetOpen(state)
        open = state
        Tween(row, { Size = UDim2.new(1, 0, 0, TargetHeight()) }, 0.2)
        Tween(arrow, { Rotation = open and 90 or 0 }, 0.2)
    end

    local function Choose(opt)
        if multi then
            selected[opt] = (not selected[opt]) or nil
        else
            selected = { [opt] = true }
        end
        RenderValue()
        RenderOptions()
        Commit(false)
        if not multi and cfg.CloseOnSelect ~= false then SetOpen(false) end
    end

    local function Rebuild()
        for _, b in pairs(buttons) do b.btn:Destroy() end
        buttons = {}
        for i, opt in ipairs(options) do
            local btn = New("TextButton", {
                Name = opt, Size = UDim2.new(1, -6, 0, 26), LayoutOrder = i, BackgroundTransparency = 1,
                Theme = { BackgroundColor3 = "SurfaceHover" }, Parent = list,
            }, { Corner(5) })
            local lbl = New("TextLabel", {
                Text = opt, Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(10, 0), TextSize = 12,
                TextColor3 = Library.Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
            })
            btn.MouseEnter:Connect(function()
                if not selected[opt] then Tween(btn, { BackgroundTransparency = 0.5 }, 0.1) end
            end)
            btn.MouseLeave:Connect(function()
                if not selected[opt] then Tween(btn, { BackgroundTransparency = 1 }, 0.1) end
            end)
            btn.MouseButton1Click:Connect(function() Choose(opt) end)
            buttons[opt] = { btn = btn, lbl = lbl }
        end
        list.Size = UDim2.new(1, -12, 0, math.min(#options * 28, 150))
        RenderOptions()
        if open then Tween(row, { Size = UDim2.new(1, 0, 0, TargetHeight()) }, 0.2) end
    end

    -- initial selection
    local def = cfg.Default
    if multi and type(def) == "table" then
        for _, x in ipairs(def) do selected[tostring(x)] = true end
    elseif not multi and def ~= nil and def ~= "" then
        selected[tostring(def)] = true
    end
    Rebuild()
    RenderValue()

    hit.MouseButton1Click:Connect(function() SetOpen(not open) end)

    function el:Get() return GetValue() end
    function el:Set(v, silent)
        selected = {}
        if multi then
            if type(v) == "table" then
                for _, x in ipairs(v) do selected[tostring(x)] = true end
            end
        elseif v ~= nil and v ~= "" then
            selected[tostring(v)] = true
        end
        RenderValue()
        RenderOptions()
        Commit(silent)
    end
    function el:Refresh(newOptions, clearSelection)
        options = {}
        for _, o in ipairs(newOptions or {}) do table.insert(options, tostring(o)) end
        if clearSelection then
            selected = {}
        else
            local keep = {}
            for _, o in ipairs(options) do
                if selected[o] then keep[o] = true end
            end
            selected = keep
        end
        Rebuild()
        RenderValue()
    end
    function el:_Export()
        local v = GetValue()
        if multi then return v end
        return v or ""
    end
    function el:_Import(v) self:Set(v) end
    return self:_Finish(el, row, cfg, j)
end

-- -------------------------------------------------------------- Keybind
-- Modes: "Press" -> Callback(), "Hold" -> Callback(isDown), "Toggle" -> Callback(state), "None" -> bind only.
-- OnChanged(key) fires whenever the bound key changes. Flag value: EnumItem or nil.
function Container:AddKeybind(cfg)
    cfg = cfg or {}
    local j = self:_J()
    local mode = cfg.Mode or "Press"
    local key = ResolveKey(cfg.Default)
    local state = false
    local listening = false
    local el = { Type = "Keybind" }

    local row = self:_Row(36)
    MakeHeader(row, cfg.Name or "Keybind", nil, 110)
    local btn = New("TextButton", {
        Size = UDim2.fromOffset(92, 22), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        BackgroundTransparency = 0, TextSize = 12,
        Theme = { BackgroundColor3 = "SurfaceHover", TextColor3 = "SubText" }, Parent = row,
    }, { Corner(4) })
    local hit = MakeHit(row)
    AttachHover(hit, row)

    local function Render()
        if listening then
            btn.Text = "..."
            btn.TextColor3 = Library.Theme.Accent
        else
            btn.Text = key and key.Name or "None"
            btn.TextColor3 = Library.Theme.SubText
        end
    end
    Render()

    local function Matches(input)
        if not key then return false end
        if key.EnumType == Enum.KeyCode then return input.KeyCode == key end
        return input.UserInputType == key
    end

    local function SetKey(newKey, silent)
        key = newKey
        if el.Flag then Library.Flags[el.Flag] = key end
        Render()
        if not silent then Fire(cfg.OnChanged, key) end
    end

    hit.MouseButton1Click:Connect(function()
        listening = not listening
        Library._listening = listening
        Render()
    end)

    On(j, UserInputService.InputBegan, function(input, processed)
        if listening then
            local newKey, apply = nil, false
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    listening = false
                    Library._listening = false
                    Render()
                    return
                elseif input.KeyCode == Enum.KeyCode.Backspace then
                    newKey, apply = nil, true
                else
                    newKey, apply = input.KeyCode, true
                end
            elseif input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                newKey, apply = input.UserInputType, true
            end
            if apply then
                listening = false
                Library._listening = false
                SetKey(newKey, false)
            end
            return
        end
        if processed or mode == "None" or not Matches(input) then return end
        if mode == "Press" then
            Fire(cfg.Callback)
        elseif mode == "Toggle" then
            state = not state
            Fire(cfg.Callback, state)
        elseif mode == "Hold" then
            state = true
            Fire(cfg.Callback, true)
        end
    end)
    On(j, UserInputService.InputEnded, function(input)
        if mode == "Hold" and state and Matches(input) then
            state = false
            Fire(cfg.Callback, false)
        end
    end)
    j:Give(function()
        if listening then Library._listening = false end
    end)
    Library:_OnTheme(Render, j)

    function el:Get() return key end
    function el:GetState() return state end
    function el:Set(v, silent) SetKey(ResolveKey(v), silent) end
    function el:_Export() return key and key.Name or "" end
    function el:_Import(v) self:Set(v) end
    return self:_Finish(el, row, cfg, j)
end

-- ---------------------------------------------------------- ColorPicker
function Container:AddColorPicker(cfg)
    cfg = cfg or {}
    local j = self:_J()
    local page = self.Page
    local h, s, v = (cfg.Default or Color3.fromRGB(255, 255, 255)):ToHSV()
    local open = false
    local el = { Type = "ColorPicker" }

    local function Current() return Color3.fromHSV(h, s, v) end

    local row = self:_Row(36)
    New("TextLabel", {
        Text = tostring(cfg.Name or "Color"), Size = UDim2.new(1, -70, 0, 18), Position = UDim2.fromOffset(12, 9),
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
    })
    local swatch = New("Frame", {
        Size = UDim2.fromOffset(34, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 9),
        BackgroundColor3 = Current(), Parent = row,
    }, { Corner(4), New("UIStroke", { Thickness = 1, Theme = { Color = "Outline" } }) })
    local hit = MakeHit(row, 36)
    AttachHover(hit, row)

    local sv = New("Frame", {
        Position = UDim2.fromOffset(10, 44), Size = UDim2.new(1, -20, 0, 110),
        BackgroundColor3 = Color3.fromHSV(h, 1, 1), Parent = row,
    }, { Corner(5) })
    local white = New("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sv,
    }, {
        Corner(5),
        New("UIGradient", { Transparency = NumberSequence.new(0, 1) }),
    })
    local black = New("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Parent = sv,
    }, {
        Corner(5),
        New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }),
    })
    local svCursor = New("Frame", {
        Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(s, 1 - v),
        BackgroundTransparency = 1, ZIndex = 3, Parent = sv,
    }, { Round(), New("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }) })
    local svHit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = sv })

    local hue = New("Frame", {
        Position = UDim2.fromOffset(10, 162), Size = UDim2.new(1, -20, 0, 12),
        BackgroundColor3 = Color3.new(1, 1, 1), Parent = row,
    }, {
        Corner(6),
        New("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
                ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
                ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
                ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
                ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
                ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
            }),
        }),
    })
    local hueMarker = New("Frame", {
        Size = UDim2.fromOffset(4, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(h, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 3, Parent = hue,
    }, { Corner(2), New("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.5 }) })
    local hueHit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = hue })

    local hex = New("TextBox", {
        Position = UDim2.fromOffset(10, 182), Size = UDim2.new(1, -20, 0, 24), Text = "",
        PlaceholderText = "#RRGGBB", TextXAlignment = Enum.TextXAlignment.Center,
        Theme = { BackgroundColor3 = "SurfaceHover", PlaceholderColor3 = "SubText" }, Parent = row,
    }, { Corner(4) })

    local function Render()
        local c = Current()
        swatch.BackgroundColor3 = c
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.fromScale(s, 1 - v)
        hueMarker.Position = UDim2.new(h, 0, 0.5, 0)
        if not hex:IsFocused() then hex.Text = ToHex(c) end
    end
    Render()

    local function Commit(silent)
        if el.Flag then Library.Flags[el.Flag] = Current() end
        if not silent then Fire(cfg.Callback, Current()) end
    end

    local svDrag, hueDrag = false, false
    local function UpdateSV(input)
        local sz, pos = sv.AbsoluteSize, sv.AbsolutePosition
        if sz.X <= 0 or sz.Y <= 0 then return end
        s = math.clamp((input.Position.X - pos.X) / sz.X, 0, 1)
        v = 1 - math.clamp((input.Position.Y - pos.Y) / sz.Y, 0, 1)
        Render()
        Commit(false)
    end
    local function UpdateHue(input)
        local sz, pos = hue.AbsoluteSize, hue.AbsolutePosition
        if sz.X <= 0 then return end
        h = math.clamp((input.Position.X - pos.X) / sz.X, 0, 1)
        Render()
        Commit(false)
    end
    svHit.InputBegan:Connect(function(input)
        if IsPress(input) then
            svDrag = true
            page.ScrollingEnabled = false
            UpdateSV(input)
        end
    end)
    hueHit.InputBegan:Connect(function(input)
        if IsPress(input) then
            hueDrag = true
            page.ScrollingEnabled = false
            UpdateHue(input)
        end
    end)
    On(j, UserInputService.InputChanged, function(input)
        if not IsMove(input) then return end
        if svDrag then UpdateSV(input) elseif hueDrag then UpdateHue(input) end
    end)
    On(j, UserInputService.InputEnded, function(input)
        if IsPress(input) and (svDrag or hueDrag) then
            svDrag, hueDrag = false, false
            page.ScrollingEnabled = true
        end
    end)

    hex.FocusLost:Connect(function()
        local c = FromHex(hex.Text)
        if c then el:Set(c) else Render() end
    end)

    hit.MouseButton1Click:Connect(function()
        open = not open
        Tween(row, { Size = UDim2.new(1, 0, 0, open and 216 or 36) }, 0.2)
    end)

    function el:Get() return Current() end
    function el:Set(c, silent)
        if typeof(c) == "Color3" then
            h, s, v = c:ToHSV()
            Render()
            Commit(silent)
        end
    end
    function el:_Export() return ToHex(Current()) end
    function el:_Import(x)
        local c = FromHex(x)
        if c then self:Set(c) end
    end
    return self:_Finish(el, row, cfg, j)
end

-- ------------------------------------------------------------ TextInput
function Container:AddTextInput(cfg)
    cfg = cfg or {}
    local j = self:_J()
    local value = tostring(cfg.Default or "")
    local el = { Type = "TextInput" }
    local row = self:_Row(36)
    New("TextLabel", {
        Text = tostring(cfg.Name or "Input"), Size = UDim2.new(1, -176, 0, 18), Position = UDim2.fromOffset(12, 9),
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
    })
    local box = New("TextBox", {
        Size = UDim2.fromOffset(150, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Text = value, PlaceholderText = tostring(cfg.Placeholder or ""), ClearTextOnFocus = cfg.ClearOnFocus == true,
        Theme = { BackgroundColor3 = "SurfaceHover", PlaceholderColor3 = "SubText" }, Parent = row,
    }, { Corner(4), New("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })

    local function Read()
        if cfg.Numeric then
            local n = tonumber(box.Text)
            if n then return n end
            return nil
        end
        return box.Text
    end

    box.FocusLost:Connect(function()
        local r = Read()
        if r == nil then
            box.Text = value
            return
        end
        value = tostring(r)
        if el.Flag then Library.Flags[el.Flag] = r end
        Fire(cfg.Callback, r)
    end)

    function el:Get()
        if cfg.Numeric then return tonumber(value) end
        return value
    end
    function el:Set(t, silent)
        value = tostring(t or "")
        box.Text = value
        if self.Flag then Library.Flags[self.Flag] = self:Get() end
        if not silent then Fire(cfg.Callback, self:Get()) end
    end
    function el:_Export() return value end
    function el:_Import(x) self:Set(x) end
    return self:_Finish(el, row, cfg, j)
end

----------------------------------------------------------------------
-- Tab and Window classes
----------------------------------------------------------------------
local Tab = setmetatable({}, { __index = Container })
Tab.__index = Tab

function Tab:Select()
    self.Window.ActiveTab = self
    self.Window:_RefreshTabs()
end

local Window = {}
Window.__index = Window

function Window:_RefreshTabs()
    for _, t in ipairs(self.Tabs) do
        local active = (t == self.ActiveTab)
        Tween(t._button, { BackgroundTransparency = active and 0 or 1 }, 0.15)
        Tween(t._label, { TextColor3 = active and Library.Theme.Text or Library.Theme.SubText }, 0.15)
        if t._icon then
            Tween(t._icon, { ImageColor3 = active and Library.Theme.Accent or Library.Theme.SubText }, 0.15)
        end
        t._indicator.Visible = active
        t._page.Visible = active
    end
end

function Window:CreateTab(cfg, iconArg)
    if type(cfg) == "string" then cfg = { Name = cfg, Icon = iconArg } end
    cfg = cfg or {}
    local name = tostring(cfg.Name or "Tab")

    local button = New("TextButton", {
        Name = name, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = #self.Tabs + 1,
        Theme = { BackgroundColor3 = "SurfaceHover" }, Parent = self._tabList,
    }, { Corner(6) })
    local indicator = New("Frame", {
        Size = UDim2.fromOffset(3, 16), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        Visible = false, Theme = { BackgroundColor3 = "Accent" }, Parent = button,
    }, { Round() })
    local textX = 14
    local icon
    if cfg.Icon then
        textX = 36
        icon = New("ImageLabel", {
            Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 14, 0.5, -8), Image = tostring(cfg.Icon),
            ImageColor3 = Library.Theme.SubText, Parent = button,
        })
    end
    local label = New("TextLabel", {
        Text = name, Size = UDim2.new(1, -textX - 6, 1, 0), Position = UDim2.fromOffset(textX, 0),
        TextColor3 = Library.Theme.SubText, TextTruncate = Enum.TextTruncate.AtEnd, Parent = button,
    })
    local page = New("ScrollingFrame", {
        Name = name, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self._pages,
    }, {
        New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
        New("UIPadding", {
            PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 16),
        }),
    })

    local tab = setmetatable({
        Window = self, Name = name, Page = page, Container = page, _order = 0,
        _button = button, _label = label, _indicator = indicator, _icon = icon, _page = page,
    }, Tab)
    table.insert(self.Tabs, tab)

    button.MouseButton1Click:Connect(function() tab:Select() end)
    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then Tween(button, { BackgroundTransparency = 0.6 }, 0.1) end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then Tween(button, { BackgroundTransparency = 1 }, 0.1) end
    end)

    if #self.Tabs == 1 then tab:Select() end
    return tab
end

function Window:SetVisible(v)
    if self.Destroyed then return end
    self.Visible = v
    local main, scale = self._main, self._scale
    if v then
        main.Visible = true
        Tween(main, { GroupTransparency = 0 }, 0.2)
        Tween(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
    else
        Tween(main, { GroupTransparency = 1 }, 0.18)
        Tween(scale, { Scale = 0.95 }, 0.18)
        task.delay(0.2, function()
            if not self.Visible and not self.Destroyed then main.Visible = false end
        end)
    end
    if self._mobileBtn then self._mobileBtn.Visible = (not v) and self._ready == true end
end

function Window:Toggle() self:SetVisible(not self.Visible) end
function Window:SetToggleKey(key) self.ToggleKey = ResolveKey(key) or self.ToggleKey end
function Window:SetTitle(t) self._titleLabel.Text = tostring(t) end
function Window:SetSubtitle(t) self._subtitleLabel.Text = tostring(t) end

function Window:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    self.Janitor:Destroy()
    for _, flag in ipairs(self._flags) do
        Library.Elements[flag] = nil
        Library.Flags[flag] = nil
    end
    for i, w in ipairs(Library.Windows) do
        if w == self then
            table.remove(Library.Windows, i)
            break
        end
    end
    Library._listening = false
    pcall(function() self.ScreenGui:Destroy() end)
end

-- ---------------------------------------------------------- Notifications
local NotifyColors = { Info = "Accent", Success = "Success", Warning = "Warning", Error = "Error" }

function Window:Notify(cfg)
    if self.Destroyed then return end
    if type(cfg) ~= "table" then cfg = { Content = tostring(cfg) } end
    local colorKey = NotifyColors[cfg.Type or "Info"] or "Accent"
    local title = tostring(cfg.Title or "Picaroon Hub")
    local content = tostring(cfg.Content or "")
    local duration = cfg.Duration or 4
    local width = 280

    local textH = TextService:GetTextSize(content, 12, Enum.Font.Gotham, Vector2.new(width - 28, 10000)).Y
    local height = 30 + textH + 16

    self._notifyOrder = self._notifyOrder + 1
    local wrapper = New("Frame", {
        Size = UDim2.fromOffset(width, height), BackgroundTransparency = 1, ClipsDescendants = true,
        LayoutOrder = self._notifyOrder, Parent = self._notifyHolder,
    })
    local card = New("Frame", {
        Size = UDim2.fromOffset(width, height), Position = UDim2.new(1, 40, 0, 0),
        Theme = { BackgroundColor3 = "Surface" }, Parent = wrapper,
    }, {
        Corner(8),
        New("UIStroke", { Thickness = 1, Theme = { Color = "Outline" } }),
    })
    New("Frame", {
        Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(0, 8),
        Theme = { BackgroundColor3 = colorKey }, Parent = card,
    }, { Round() })
    New("TextLabel", {
        Text = title, Size = UDim2.new(1, -28, 0, 16), Position = UDim2.fromOffset(14, 8),
        Font = Enum.Font.GothamBold, Parent = card,
    })
    New("TextLabel", {
        Text = content, Size = UDim2.new(1, -28, 0, textH), Position = UDim2.fromOffset(14, 28),
        Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
        Theme = { TextColor3 = "SubText" }, Parent = card,
    })
    local bar = New("Frame", {
        Size = UDim2.new(1, -28, 0, 2), Position = UDim2.new(0, 14, 1, -6),
        Theme = { BackgroundColor3 = colorKey }, Parent = card,
    }, { Round() })
    local click = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = card })

    local dismissed = false
    local function Dismiss()
        if dismissed then return end
        dismissed = true
        Tween(card, { Position = UDim2.new(1, 40, 0, 0) }, 0.25)
        task.wait(0.25)
        Tween(wrapper, { Size = UDim2.fromOffset(width, 0) }, 0.2)
        task.wait(0.2)
        wrapper:Destroy()
    end

    Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.3, Enum.EasingStyle.Back)
    Tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
    click.MouseButton1Click:Connect(function() task.spawn(Dismiss) end)
    task.delay(duration, function() Dismiss() end)
end

function Library:Notify(cfg)
    local w = self.Windows[1]
    if w then return w:Notify(cfg) end
end

----------------------------------------------------------------------
-- Settings tab (theme, menu key, unload, configs)
----------------------------------------------------------------------
function Window:CreateSettingsTab(cfg)
    cfg = cfg or {}
    local tab = self:CreateTab({ Name = cfg.Name or "Settings", Icon = cfg.Icon })
    local ui = tab:AddSection("Interface")

    local presetNames = {}
    for name in pairs(Library.ThemePresets) do table.insert(presetNames, name) end
    table.sort(presetNames)

    local accent
    ui:AddDropdown({
        Name = "Theme", Options = presetNames, Default = "Violet",
        Callback = function(choice)
            if choice and Library:SetTheme(choice) and accent then
                accent:Set(Library.Theme.Accent, true)
            end
        end,
    })
    accent = ui:AddColorPicker({
        Name = "Accent color", Default = Library.Theme.Accent,
        Callback = function(c) Library:SetTheme({ Accent = c }) end,
    })
    ui:AddKeybind({
        Name = "Menu key", Default = self.ToggleKey, Mode = "None",
        OnChanged = function(k)
            if k and k.EnumType == Enum.KeyCode then self.ToggleKey = k end
        end,
    })
    ui:AddButton({ Name = "Unload interface", Callback = function() Library:Unload() end })

    local cs = tab:AddSection("Configuration")
    if not FSAvailable() then
        cs:AddLabel("This executor does not expose the file system functions needed for configs.")
        return tab
    end

    local nameInput = cs:AddTextInput({ Name = "Config name", Placeholder = "default" })
    local configList = cs:AddDropdown({ Name = "Saved configs", Options = Library:ListConfigs() })

    local function PickName()
        local n = SanitizeName(nameInput:Get())
        if n == "" then n = SanitizeName(configList:Get() or "") end
        return n
    end
    local function Report(ok, info, okText)
        if ok then
            self:Notify({ Title = "Config", Content = okText, Type = "Success" })
        else
            self:Notify({ Title = "Config", Content = tostring(info), Type = "Error" })
        end
    end

    cs:AddButton({
        Name = "Save config",
        Callback = function()
            local n = PickName()
            local ok, info = Library:SaveConfig(n)
            if ok then configList:Refresh(Library:ListConfigs()) configList:Set(n, true) end
            Report(ok, info, "Saved '" .. n .. "'")
        end,
    })
    cs:AddButton({
        Name = "Load config",
        Callback = function()
            local n = PickName()
            local ok, info = Library:LoadConfig(n)
            Report(ok, info, "Loaded '" .. n .. "' (" .. tostring(info) .. " values applied)")
        end,
    })
    cs:AddButton({
        Name = "Delete config",
        Callback = function()
            local n = PickName()
            local ok, info = Library:DeleteConfig(n)
            if ok then configList:Refresh(Library:ListConfigs(), true) end
            Report(ok, info, "Deleted '" .. n .. "'")
        end,
    })
    cs:AddButton({
        Name = "Refresh list",
        Callback = function() configList:Refresh(Library:ListConfigs()) end,
    })
    return tab
end

