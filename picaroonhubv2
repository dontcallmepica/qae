-- -------------------------------------------------------------- Section
function Container:AddSection(name, collapsible)
    local frame = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        LayoutOrder = self:_Next(), Parent = self.Container,
    }, { New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local header = New("TextButton", {
        Name = "Header", Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, Parent = frame,
    })
    New("TextLabel", {
        Text = string.upper(tostring(name or "Section")), Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.fromOffset(2, 0), Font = Enum.Font.GothamBold, TextSize = 11,
        Theme = { TextColor3 = "SubText" }, Parent = header,
    })
    local arrow
    if collapsible then
        arrow = New("TextLabel", {
            Text = ">", Size = UDim2.fromOffset(16, 20), Position = UDim2.new(1, -16, 0, 0), Rotation = 90,
            TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold,
            Theme = { TextColor3 = "SubText" }, Parent = header,
        })
    end

    local content = New("Frame", {
        Name = "Content", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = 1, Parent = frame,
    }, { New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local section = setmetatable({
        Window = self.Window, Page = self.Page, Container = content, _order = 0, Frame = frame,
    }, Container)

    if collapsible then
        local open = true
        header.MouseButton1Click:Connect(function()
            open = not open
            content.Visible = open
            Tween(arrow, { Rotation = open and 90 or 0 }, 0.15)
        end)
    end
    return section
end

