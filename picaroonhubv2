----------------------------------------------------------------------
-- Janitor (cleanup tracker)
----------------------------------------------------------------------
local function Dispose(x)
    local t = typeof(x)
    if t == "RBXScriptConnection" then
        x:Disconnect()
    elseif t == "Instance" then
        x:Destroy()
    elseif t == "function" then
        pcall(x)
    elseif t == "thread" then
        pcall(task.cancel, x)
    elseif t == "table" then
        if x.Cleanup then x:Cleanup() elseif x.Destroy then pcall(x.Destroy, x) end
    end
end

local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
    return setmetatable({ _items = {}, _dead = false }, Janitor)
end

function Janitor:Give(item)
    if self._dead then
        Dispose(item)
        return item
    end
    table.insert(self._items, item)
    return item
end

function Janitor:Cleanup()
    for i = #self._items, 1, -1 do
        local item = self._items[i]
        self._items[i] = nil
        Dispose(item)
    end
end

function Janitor:Destroy()
    self:Cleanup()
    self._dead = true
end

local function On(janitor, signal, fn)
    return janitor:Give(signal:Connect(fn))
end

Library.Janitor = Janitor.new()

----------------------------------------------------------------------
-- Utilities
----------------------------------------------------------------------
local function Fire(cb, ...)
    if type(cb) ~= "function" then return end
    local ok, err = pcall(cb, ...)
    if not ok then warn("[Picaroon] callback error: " .. tostring(err)) end
end

local function Tween(inst, props, time, style, dir)
    if not time or time <= 0 then
        for k, v in pairs(props) do inst[k] = v end
        return nil
    end
    local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function RandomName()
    return HttpService:GenerateGUID(false)
end

local function IsPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function ToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function FromHex(s)
    if type(s) ~= "string" then return nil end
    local h = s:gsub("#", ""):match("^(%x%x%x%x%x%x)$")
    if not h then return nil end
    return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16))
end

local function DecimalsOf(n)
    local s = string.format("%.6f", n):gsub("0+$", "")
    local frac = s:match("%.(%d*)$") or ""
    return #frac
end

local function ResolveKey(v)
    if typeof(v) == "EnumItem" then return v end
    if type(v) == "string" and v ~= "" then
        local ok, r = pcall(function() return Enum.KeyCode[v] end)
        if ok and r then return r end
        ok, r = pcall(function() return Enum.UserInputType[v] end)
        if ok and r then return r end
    end
    return nil
end

----------------------------------------------------------------------
-- Instance factory with theme binding
----------------------------------------------------------------------
local Bindings = setmetatable({}, { __mode = "k" }) -- instance -> list of {property, themeKey}

local function Bind(inst, prop, key)
    inst[prop] = Library.Theme[key]
    local list = Bindings[inst]
    if not list then
        list = {}
        Bindings[inst] = list
    end
    table.insert(list, { prop, key })
end

local TextClasses = { TextLabel = true, TextButton = true, TextBox = true }

local Defaults = {
    Frame = { BorderSizePixel = 0 },
    CanvasGroup = { BorderSizePixel = 0 },
    ScrollingFrame = {
        BorderSizePixel = 0, BackgroundTransparency = 1, ScrollBarThickness = 3,
        CanvasSize = UDim2.new(0, 0, 0, 0), ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    },
    TextLabel = {
        BackgroundTransparency = 1, BorderSizePixel = 0, Font = Enum.Font.GothamMedium,
        TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
    },
    TextButton = {
        AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium, Text = "", TextSize = 13,
    },
    TextBox = {
        BorderSizePixel = 0, Font = Enum.Font.Gotham, TextSize = 12,
        ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
    },
    ImageLabel = { BackgroundTransparency = 1, BorderSizePixel = 0 },
}

local function New(class, props, children)
    local inst = Instance.new(class)
    props = props or {}
    local theme = props.Theme
    local defaults = Defaults[class]
    if defaults then
        for k, v in pairs(defaults) do inst[k] = v end
    end
    for k, v in pairs(props) do
        if k ~= "Parent" and k ~= "Theme" then inst[k] = v end
    end
    if TextClasses[class] and props.TextColor3 == nil and not (theme and theme.TextColor3) then
        Bind(inst, "TextColor3", "Text")
    end
    if class == "ScrollingFrame" and props.ScrollBarImageColor3 == nil and not (theme and theme.ScrollBarImageColor3) then
        Bind(inst, "ScrollBarImageColor3", "Accent")
    end
    if theme then
        for prop, key in pairs(theme) do Bind(inst, prop, key) end
    end
    if children then
        for _, c in ipairs(children) do c.Parent = inst end
    end
    if props.Parent then inst.Parent = props.Parent end
    return inst
end

local function Corner(r) return New("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function Round() return New("UICorner", { CornerRadius = UDim.new(1, 0) }) end

----------------------------------------------------------------------
-- Theme API
----------------------------------------------------------------------
function Library:_OnTheme(fn, janitor)
    table.insert(self._themeCallbacks, fn)
    if janitor then
        janitor:Give(function()
            for i, f in ipairs(self._themeCallbacks) do
                if f == fn then
                    table.remove(self._themeCallbacks, i)
                    break
                end
            end
        end)
    end
end

-- SetTheme("Crimson") applies a preset on top of the defaults;
-- SetTheme({ Accent = Color3.fromRGB(...) }) overrides single tokens.
function Library:SetTheme(t)
    if type(t) == "string" then
        local preset = self.ThemePresets[t]
        if not preset then return false end
        local merged = {}
        for k, v in pairs(DefaultTheme) do merged[k] = v end
        for k, v in pairs(preset) do merged[k] = v end
        t = merged
    end
    if type(t) ~= "table" then return false end
    for k, v in pairs(t) do self.Theme[k] = v end
    for inst, list in pairs(Bindings) do
        for _, b in ipairs(list) do
            pcall(Tween, inst, { [b[1]] = self.Theme[b[2]] }, 0.25)
        end
    end
    local copy = {}
    for i, f in ipairs(self._themeCallbacks) do copy[i] = f end
    for _, f in ipairs(copy) do pcall(f) end
    return true
end

----------------------------------------------------------------------
-- Executor file system helpers (configs)
----------------------------------------------------------------------
local function FSAvailable()
    return type(writefile) == "function" and type(readfile) == "function"
        and type(isfolder) == "function" and type(makefolder) == "function"
        and type(listfiles) == "function"
end
Library.FileSystemAvailable = FSAvailable

local function EnsureFolder(path)
    local built = ""
    for seg in string.gmatch(path, "[^/\\]+") do
        built = (built == "") and seg or (built .. "/" .. seg)
        local ok, exists = pcall(isfolder, built)
        if ok and not exists then pcall(makefolder, built) end
    end
end

local function SanitizeName(name)
    name = tostring(name or ""):gsub("[^%w _%-]", "")
    return (name:match("^%s*(.-)%s*$"))
end

function Library:SetConfigFolder(path)
    self.ConfigFolder = path
end

function Library:SaveConfig(name)
    name = SanitizeName(name)
    if name == "" then return false, "invalid config name" end
    if not FSAvailable() then return false, "file system API not available in this executor" end
    EnsureFolder(self.ConfigFolder)
    local data = {}
    for flag, el in pairs(self.Elements) do
        if el._Export then
            local ok, v = pcall(el._Export, el)
            if ok and v ~= nil then data[flag] = v end
        end
    end
    local ok, json = pcall(function()
        return HttpService:JSONEncode({ Version = 1, Flags = data })
    end)
    if not ok then return false, "encode failed: " .. tostring(json) end
    local wrote, err = pcall(writefile, self.ConfigFolder .. "/" .. name .. ".json", json)
    if not wrote then return false, tostring(err) end
    return true
end

function Library:LoadConfig(name)
    name = SanitizeName(name)
    if name == "" then return false, "invalid config name" end
    if not FSAvailable() then return false, "file system API not available in this executor" end
    local path = self.ConfigFolder .. "/" .. name .. ".json"
    local okRead, content = pcall(readfile, path)
    if not okRead then return false, "config not found" end
    local okDec, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not okDec or type(data) ~= "table" or type(data.Flags) ~= "table" then
        return false, "config file is corrupt"
    end
    local applied = 0
    for flag, v in pairs(data.Flags) do
        local el = self.Elements[flag]
        if el and el._Import then
            if pcall(el._Import, el, v) then applied = applied + 1 end
        end
    end
    return true, applied
end

function Library:ListConfigs()
    local out = {}
    if not FSAvailable() then return out end
    EnsureFolder(self.ConfigFolder)
    local ok, files = pcall(listfiles, self.ConfigFolder)
    if not ok or type(files) ~= "table" then return out end
    for _, path in ipairs(files) do
        local base = tostring(path):match("([^/\\]+)%.json$")
        if base then table.insert(out, base) end
    end
    table.sort(out)
    return out
end

function Library:DeleteConfig(name)
    name = SanitizeName(name)
    if name == "" then return false, "invalid config name" end
    if type(delfile) ~= "function" then return false, "delfile not available in this executor" end
    local ok, err = pcall(delfile, self.ConfigFolder .. "/" .. name .. ".json")
    if not ok then return false, tostring(err) end
    return true
end

----------------------------------------------------------------------
-- Gui mounting
----------------------------------------------------------------------
local function MountGui(gui)
    if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end
    local ok = false
    if type(gethui) == "function" then
        ok = pcall(function() gui.Parent = gethui() end)
    end
    if not ok or not gui.Parent then
        ok = pcall(function() gui.Parent = CoreGui end)
    end
    if not ok or not gui.Parent then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

----------------------------------------------------------------------
-- Drag helper
----------------------------------------------------------------------
local function MakeDraggable(handle, target, gui, janitor)
    local dragging = false
    local startMouse, startPos
    On(janitor, handle.InputBegan, function(input)
        if IsPress(input) then
            dragging = true
            startMouse = Vector2.new(input.Position.X, input.Position.Y)
            startPos = target.Position
        end
    end)
    On(janitor, UserInputService.InputChanged, function(input)
        if dragging and IsMove(input) then
            local d = Vector2.new(input.Position.X, input.Position.Y) - startMouse
            local vp, sz = gui.AbsoluteSize, target.AbsoluteSize
            local ox = math.clamp(startPos.X.Offset + d.X, -(vp.X / 2 + sz.X / 2 - 80), vp.X / 2 + sz.X / 2 - 80)
            local oy = math.clamp(startPos.Y.Offset + d.Y, -vp.Y / 2 + sz.Y / 2, vp.Y / 2 + sz.Y / 2 - 40)
            target.Position = UDim2.new(startPos.X.Scale, ox, startPos.Y.Scale, oy)
        end
    end)
    On(janitor, UserInputService.InputEnded, function(input)
        if IsPress(input) then dragging = false end
    end)
end

-- Geass sigil, traced from the reference image (326 x 312 px) as a thick polyline:
-- left wing, inner notch, bottom point, then the mirrored right side.
local GeassPoints = { -- { x, y, thickness }: wings taper toward the tips
    { 0, 90, 10 }, { 40, 110, 16 }, { 85, 134, 22 }, { 124, 158, 28 }, { 100, 198, 28 }, { 163, 252, 26 },
    { 226, 198, 28 }, { 202, 158, 28 }, { 241, 134, 22 }, { 286, 110, 16 }, { 326, 90, 10 },
}
local GEASS_W, GEASS_H = 326, 312

local function MakeGeass(parent, size)
    local k = size / GEASS_W
    local holder = New("Frame", {
        Name = "Geass", Size = UDim2.fromOffset(size, math.floor(GEASS_H * k + 0.5)),
        BackgroundTransparency = 1, Parent = parent,
    })
    for i = 1, #GeassPoints - 1 do
        local a, b = GeassPoints[i], GeassPoints[i + 1]
        local ax, ay, bx, by = a[1] * k, a[2] * k, b[1] * k, b[2] * k
        local t = math.max(2, ((a[3] + b[3]) / 2) * k)
        local dx, dy = bx - ax, by - ay
        local len = math.sqrt(dx * dx + dy * dy)
        New("Frame", {
            Size = UDim2.fromOffset(len + t * 0.6, t), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2),
            Rotation = math.deg(math.atan2(dy, dx)),
            Theme = { BackgroundColor3 = "Geass" }, Parent = holder,
        }, { Round() })
    end
    return holder
end

-- cfg.Logo may be "rbxassetid://123" or an https URL to a PNG (needs writefile + getcustomasset).
-- Anything that fails to resolve falls back to the built-in Geass sigil.
local function ResolveLogo(src)
    if type(src) ~= "string" or src == "" then return nil end
    if src:match("^rbxasset") then return src end
    if src:match("^https?://") and type(writefile) == "function" and type(getcustomasset) == "function" then
        local ok, asset = pcall(function()
            EnsureFolder("Picaroon")
            writefile("Picaroon/logo_cache.png", game:HttpGet(src))
            return getcustomasset("Picaroon/logo_cache.png")
        end)
        if ok and asset then return asset end
    end
    return nil
end

local function MakeLogo(parent, size, image)
    if image then
        return New("ImageLabel", { Name = "Logo", Size = UDim2.fromOffset(size, size), Image = image, Parent = parent })
    end
    return MakeGeass(parent, size)
end

----------------------------------------------------------------------
-- Element container (shared by Tab and Section)
----------------------------------------------------------------------
local Container = {}
Container.__index = Container

function Container:_Next()
    self._order = self._order + 1
    return self._order
end

function Container:_J()
    return self.Window.Janitor:Give(Janitor.new())
end

function Container:_Row(height)
    return New("Frame", {
        Size = UDim2.new(1, 0, 0, height), ClipsDescendants = true, LayoutOrder = self:_Next(),
        Theme = { BackgroundColor3 = "Surface" }, Parent = self.Container,
    }, {
        Corner(6),
        New("UIStroke", { Thickness = 1, Theme = { Color = "Outline" } }),
    })
end

local function MakeHit(row, height)
    return New("TextButton", {
        Name = "Hit", Size = height and UDim2.new(1, 0, 0, height) or UDim2.fromScale(1, 1),
        ZIndex = 5, Parent = row,
    })
end

local function AttachHover(hit, row)
    hit.MouseEnter:Connect(function() Tween(row, { BackgroundColor3 = Library.Theme.SurfaceHover }, 0.12) end)
    hit.MouseLeave:Connect(function() Tween(row, { BackgroundColor3 = Library.Theme.Surface }, 0.12) end)
end

local function MakeHeader(row, name, desc, rightPad)
    local pad = 12 + (rightPad or 12)
    local title = New("TextLabel", {
        Name = "Title", Text = tostring(name or ""), Size = UDim2.new(1, -pad, 0, 18),
        Position = UDim2.fromOffset(12, desc and 7 or 9), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
    })
    local d
    if desc then
        d = New("TextLabel", {
            Name = "Description", Text = tostring(desc), Size = UDim2.new(1, -pad, 0, 14),
            Position = UDim2.fromOffset(12, 25), TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd,
            Theme = { TextColor3 = "SubText" }, Parent = row,
        })
    end
    return title, d
end

function Container:_Finish(el, row, cfg, j)
    el.Instance = row
    function el:SetVisible(v) row.Visible = v end
    function el:Destroy()
        if self.Flag and Library.Elements[self.Flag] == self then
            Library.Elements[self.Flag] = nil
            Library.Flags[self.Flag] = nil
        end
        j:Cleanup()
        row:Destroy()
    end
    if cfg.Flag then
        if Library.Elements[cfg.Flag] then
            warn("[Picaroon] duplicate flag '" .. tostring(cfg.Flag) .. "', the newer element replaces the older one")
        end
        el.Flag = cfg.Flag
        Library.Elements[cfg.Flag] = el
        Library.Flags[cfg.Flag] = el:Get()
        table.insert(self.Window._flags, cfg.Flag)
    end
    return el
end

local function Ripple(row, x, y)
    local rx = x - row.AbsolutePosition.X
    local ry = y - row.AbsolutePosition.Y
    local d = math.max(row.AbsoluteSize.X, row.AbsoluteSize.Y) * 2
    local r = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(rx, ry),
        Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 0.8,
        Theme = { BackgroundColor3 = "Accent" }, Parent = row,
    }, { Round() })
    Tween(r, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, 0.45)
    task.delay(0.5, function() r:Destroy() end)
end

-- ---------------------------------------------------------------- Label
function Container:AddLabel(text)
    local label = New("TextLabel", {
        Text = tostring(text or ""), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true, TextSize = 12, LayoutOrder = self:_Next(),
        Theme = { TextColor3 = "SubText" }, Parent = self.Container,
    }, { New("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2) }) })
    local el = { Type = "Label", Instance = label }
    function el:Set(t) label.Text = tostring(t) end
    function el:SetVisible(v) label.Visible = v end
    function el:Destroy() label:Destroy() end
    return el
end

-- ------------------------------------------------------------ Paragraph
function Container:AddParagraph(cfg)
    cfg = cfg or {}
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self:_Next(),
        Theme = { BackgroundColor3 = "Surface" }, Parent = self.Container,
    }, {
        Corner(6),
        New("UIStroke", { Thickness = 1, Theme = { Color = "Outline" } }),
        New("UIPadding", {
            PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
        }),
        New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
    })
    local title = New("TextLabel", {
        Text = tostring(cfg.Title or ""), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true, Font = Enum.Font.GothamBold, LayoutOrder = 1, Parent = row,
    })
    local body = New("TextLabel", {
        Text = tostring(cfg.Content or ""), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true, TextSize = 12, Font = Enum.Font.Gotham, LayoutOrder = 2,
        Theme = { TextColor3 = "SubText" }, Parent = row,
    })
    local el = { Type = "Paragraph", Instance = row }
    function el:Set(t, c)
        if t ~= nil then title.Text = tostring(t) end
        if c ~= nil then body.Text = tostring(c) end
    end
    function el:SetVisible(v) row.Visible = v end
    function el:Destroy() row:Destroy() end
    return el
end

