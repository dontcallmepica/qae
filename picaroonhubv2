    })
    local logo = MakeLogo(topbar, 30, logoImage)
    logo.AnchorPoint = Vector2.new(0, 0.5)
    logo.Position = UDim2.new(0, 12, 0.5, 0)
    win._titleLabel = New("TextLabel", {
        Text = tostring(cfg.Title or "Picaroon Hub"), Size = UDim2.new(1, -170, 0, 18), Position = UDim2.fromOffset(50, 7),
        Font = Enum.Font.GothamBold, TextSize = 14, Parent = topbar,
    })
    win._subtitleLabel = New("TextLabel", {
        Text = tostring(cfg.Subtitle or ("v" .. Library.Version)), Size = UDim2.new(1, -170, 0, 14),
        Position = UDim2.fromOffset(50, 25), TextSize = 11, Font = Enum.Font.Gotham,
        Theme = { TextColor3 = "SubText" }, Parent = topbar,
    })

    local function TopButton(text, xOff, hoverKey)
        local b = New("TextButton", {
            Text = text, Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, xOff, 0.5, -14),
            BackgroundTransparency = 0, Font = Enum.Font.GothamBold, TextSize = 16,
            Theme = { BackgroundColor3 = "Surface" }, Parent = topbar,
        }, { Corner(6) })
        b.MouseEnter:Connect(function() Tween(b, { BackgroundColor3 = Library.Theme[hoverKey] }, 0.12) end)
        b.MouseLeave:Connect(function() Tween(b, { BackgroundColor3 = Library.Theme.Surface }, 0.12) end)
        return b
    end
    local hideBtn = TopButton("-", -72, "SurfaceHover")
    local closeBtn = TopButton("x", -38, "Error")
    hideBtn.MouseButton1Click:Connect(function()
        win:SetVisible(false)
        win:Notify({ Title = "Hidden", Content = "Press " .. win.ToggleKey.Name .. " to open the menu again.", Duration = 3 })
    end)
    closeBtn.MouseButton1Click:Connect(function() win:Destroy() end)

    MakeDraggable(topbar, main, gui, j)

    -- body ----------------------------------------------------------
    local body = New("Frame", {
        Name = "Body", Size = UDim2.new(1, 0, 1, -46), Position = UDim2.fromOffset(0, 46),
